* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #f4f6f8;
    color: #333;
    padding: 20px;
}

header {
    max-width: 800px;
    margin: 0 auto 20px auto;
    border-bottom: 2px solid #ddd;
    padding-bottom: 15px;
    text-align: center;
}

.school-header h2 {
    font-size: 1.2rem;
    color: #0066cc;
    margin-bottom: 8px;
    text-transform: uppercase;
    font-weight: bold;
}

.meta-info {
    font-size: 0.9rem;
    color: #666;
}

.container {
    max-width: 800px;
    margin: 0 auto;
    background: #fff;
    padding: 30px;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

h1 {
    font-size: 1.8rem;
    color: #1a1a1a;
    margin-bottom: 12px;
    line-height: 1.3;
}

main h2 {
    font-size: 1.1rem;
    color: #555;
    font-weight: 400;
    margin-bottom: 20px;
    line-height: 1.4;
}

.image-container img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    margin-bottom: 20px;
}

.content p {
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 15px;
    color: #444;
}

button {
    background-color: #0066cc;
    color: white;
    border: none;
    padding: 10px 18px;
    font-size: 0.9rem;
    border-radius: 5px;
    cursor: pointer;
    margin-top: 15px;
    transition: background 0.2s;
}

button:hover {
    background-color: #004999;
}
